rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(userDocPath()).data;
    }

    function validSession() {
      return !('sessionVersion' in profile())
        || (profile().sessionVersion is string
            && request.auth.token.sessionVersion == profile().sessionVersion);
    }

    function ready() {
      return request.auth != null
        && exists(userDocPath())
        && profile().active == true
        && profile().mustChangePassword == false
        && validSession();
    }

    function isAdmin() {
      return ready() && profile().isAdmin == true;
    }

    function isDateKey(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 1. Koleksi Pengguna / Pegawai (hanya Admin SDK / Cloud Functions yang boleh menulis)
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 2. Rahasia Pengguna (hash & salt PIN — khusus Cloud Functions / Admin SDK)
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // 3. Koleksi Presensi (penulisan server-authoritative melalui Cloud Function recordAttendance)
    match /presensi/{docId} {
      allow read: if isAdmin()
        || (ready() && (
          resource == null
          || resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    // 4. Koleksi Pengajuan Izin & Cuti
    match /requests/{docId} {
      function validLeaveCreate() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'nip', 'name', 'unit', 'type', 'startDate', 'endDate', 'daysCount', 'reason', 'status', 'createdAt'])
          && d.keys().hasOnly(['uid', 'nip', 'name', 'unit', 'type', 'startDate', 'endDate', 'daysCount', 'reason', 'attachmentUrl', 'status', 'createdAt'])
          && d.uid == request.auth.uid
          && d.nip is string && d.nip.matches('^[0-9]{18}$')
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 150
          && d.unit is string && d.unit.size() <= 150
          && d.type in ['Izin', 'Cuti Tahunan', 'Cuti Sakit', 'Perjalanan Dinas', 'Koreksi Absen']
          && isDateKey(d.startDate)
          && isDateKey(d.endDate)
          && d.endDate >= d.startDate
          && d.daysCount is int && d.daysCount >= 1 && d.daysCount <= 60
          && d.reason is string && d.reason.size() >= 3 && d.reason.size() <= 500
          && (!('attachmentUrl' in d) || d.attachmentUrl == null || (d.attachmentUrl is string && d.attachmentUrl.size() <= 1000))
          && d.status == 'Menunggu'
          && d.createdAt == request.time;
      }

      function validLeaveReview() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        return resource.data.status == 'Menunggu'
          && changed.hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
          && changed.hasAll(['status', 'reviewedBy', 'reviewedAt'])
          && d.status in ['Disetujui', 'Ditolak']
          && (!('reviewNote' in d) || d.reviewNote == null || (d.reviewNote is string && d.reviewNote.size() <= 300))
          && d.reviewedBy == request.auth.uid
          && d.reviewedAt == request.time;
      }

      allow read: if isAdmin()
        || (ready() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if ready() && validLeaveCreate();
      allow update: if isAdmin() && validLeaveReview();
      allow delete: if false;
    }

    // 5. Pengaturan Umum Kantor (settings/general)
    match /settings/general {
      function validSettingsGeneral() {
        let d = request.resource.data;
        return d.keys().hasAll(['latitude', 'longitude', 'radius', 'wfhSchedule'])
          && d.keys().hasOnly(['latitude', 'longitude', 'radius', 'wfhSchedule', 'workHours', 'holidays', 'updatedAt', 'updatedBy'])
          && d.radius is number && d.radius >= 25 && d.radius <= 1000
          && (
            (d.latitude == null && d.longitude == null)
            || (d.latitude is number && d.latitude >= -90 && d.latitude <= 90
                && d.longitude is number && d.longitude >= -180 && d.longitude <= 180)
          )
          && d.wfhSchedule is map
          && (!('workHours' in d) || d.workHours is map)
          && (!('holidays' in d) || (d.holidays is list && d.holidays.size() <= 100))
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid)
          && (!('updatedAt' in d) || d.updatedAt == request.time);
      }

      allow get: if ready();
      allow write: if isAdmin() && validSettingsGeneral();
    }

    // 6. Legacy / Compatibility Collections (tetap terisolasi & ketat untuk uji regresi)
    match /policies/attendance {
      allow get: if ready();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['fridayWfh', 'latitude', 'longitude', 'radius'])
        && validState({
          'records': [],
          'requests': [],
          'employees': [],
          'fridayWfh': request.resource.data.fridayWfh,
          'latitude': request.resource.data.latitude,
          'longitude': request.resource.data.longitude,
          'radius': request.resource.data.radius
        });
    }

    match /employeeWorkspaces/{uid} {
      function owner() {
        return ready() && request.auth.uid == uid;
      }

      function validPersonal() {
        return request.resource.data.keys().hasOnly(['revision', 'data', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.revision is int
          && request.resource.data.data.keys().hasOnly(['records', 'requests'])
          && request.resource.data.data.records is list
          && request.resource.data.data.records.size() <= 500
          && request.resource.data.data.requests is list
          && request.resource.data.data.requests.size() <= 200;
      }

      allow get: if owner();
      allow create: if owner() && validPersonal() && request.resource.data.revision == 1;
      allow update: if owner() && validPersonal() && request.resource.data.revision == resource.data.revision + 1;
    }

    function validState(data) {
      return data is map
        && data.keys().hasAll(['records', 'requests', 'employees', 'fridayWfh', 'latitude', 'longitude', 'radius'])
        && data.keys().hasOnly(['records', 'requests', 'employees', 'fridayWfh', 'latitude', 'longitude', 'radius'])
        && data.records is list && data.records.size() <= 500
        && data.requests is list && data.requests.size() <= 200
        && data.employees is list && data.employees.size() <= 500
        && data.fridayWfh is bool
        && data.radius is number && data.radius >= 50 && data.radius <= 1000
        && (
          (data.latitude == null && data.longitude == null)
          || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90
              && data.longitude is number && data.longitude >= -180 && data.longitude <= 180)
        );
    }

    function validEnvelope() {
      return request.resource.data.keys().hasAll(['revision', 'data', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['revision', 'data', 'updatedAt', 'updatedBy'])
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validState(request.resource.data.data);
    }

    match /workspaces/kpu-sulut {
      allow get: if isAdmin();
      allow create: if isAdmin() && validEnvelope() && request.resource.data.revision == 1;
      allow update: if isAdmin() && validEnvelope() && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }

    // Blokir seluruh dokumen lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
